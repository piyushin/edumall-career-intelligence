# Hostinger VPS production environment template.
# Copy to .env.production on the VPS and replace every placeholder before deployment.
# Do not commit .env.production or real secrets.

NODE_ENV=production
APP_ENV=production
APP_VERSION=replace-with-approved-git-commit-sha

PUBLIC_WEB_URL=https://career.theedumall.com
PUBLIC_API_URL=https://career.theedumall.com/api
CORS_ALLOWED_ORIGINS=https://career.theedumall.com

POSTGRES_DB=replace-with-production-database-name
POSTGRES_USER=replace-with-production-database-user
POSTGRES_PASSWORD=replace-with-strong-production-database-password
DATABASE_URL=postgresql://replace-with-production-database-user:replace-with-strong-production-database-password@postgres:5432/replace-with-production-database-name?schema=public

REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-random-64-character-secret
LOG_LEVEL=info

PILOT_MODE=true
PUBLIC_REGISTRATION_ENABLED=false
ASSESSMENT_DELIVERY_ENABLED=false
REPORT_WORKER_CONCURRENCY=1
