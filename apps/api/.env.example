NODE_ENV=development
APP_ENV=local
SERVICE_NAME=api
APP_VERSION=0.1.0-local
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://edumall:replace-with-local-only-password@localhost:5432/edumall_dev?schema=public
REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local-only authentication defaults. Production must set a unique secret and secure cookies.
AUTH_COOKIE_NAME=edumall_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_CSRF_COOKIE_NAME=edumall_csrf
AUTH_CSRF_SECRET=local-development-csrf-secret-change-me
