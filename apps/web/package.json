{
  "name": "@edumall/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web foundation for the EduMall platform.",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "lint": "eslint . --max-warnings=0",
