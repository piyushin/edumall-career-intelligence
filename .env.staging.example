# Hostinger VPS staging environment template.
# Copy to .env.staging on the VPS and replace every placeholder before deployment.
# Do not commit .env.staging or real secrets.

NODE_ENV=production
APP_ENV=staging
APP_VERSION=replace-with-approved-git-commit-sha

STAGING_DOMAIN=staging-career.theedumall.com
PUBLIC_WEB_URL=https://staging-career.theedumall.com
PUBLIC_API_URL=https://staging-career.theedumall.com/api
CORS_ALLOWED_ORIGINS=https://staging-career.theedumall.com

POSTGRES_DB=replace-with-staging-database-name
POSTGRES_USER=replace-with-staging-database-user
POSTGRES_PASSWORD=replace-with-strong-staging-database-password
DATABASE_URL=postgresql://replace-with-staging-database-user:replace-with-strong-staging-database-password@postgres:5432/replace-with-staging-database-name?schema=public

REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-random-64-character-secret
LOG_LEVEL=info

CADDY_EMAIL=replace-with-operations-email@example.com
