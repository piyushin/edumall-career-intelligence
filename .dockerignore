# Every production Dockerfile (api/web/worker) COPYs the build context (repo root,
# via `context: ../..` in docker-compose.production.yml) into the image. Without this
# file, Docker respects no ignore rules of its own -- .gitignore is git-only -- so the
# production env file (.env.production, which scripts/deploy-production.sh requires to
# exist at the repo root before it runs `compose build`) would be copied straight into
# every image layer, baking AUTH_CSRF_SECRET/POSTGRES_PASSWORD/DATABASE_URL into images
# that get built on and can persist on the deploy host or any registry they're pushed
# to. This must stay at least as broad as .gitignore's secrets/build-output rules.

# Environment and secrets
.env
.env.*
!.env.example
!.env.production.example
!apps/*/.env.example
!packages/*/.env.example

# Dependencies (each Dockerfile runs its own `pnpm install` inside the image; a local
# node_modules is never needed in the build context and, if present, wastes context
# upload time and can carry host-platform-specific native bindings)
node_modules
**/node_modules
.pnpm-store

# Build output / caches (regenerated inside the image; stale host output must never be
# copied in)
dist
.next
out
coverage
.turbo
**/*.tsbuildinfo
packages/database/prisma/generated

# Version control and editor/OS artifacts
.git
.github
.idea
.vscode
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Documentation and non-runtime local config (not needed at runtime; keeping the
# build context small also keeps `docker build` fast)
docs
*.md
