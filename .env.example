# Copy to .env for local development. Values here are placeholders only.
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.1.0-local
LOG_LEVEL=info

# Local service ports. Docker Compose binds these to 127.0.0.1 only.
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002
POSTGRES_PORT=5432
REDIS_PORT=6379

# Replace placeholder values in your local .env. Do not commit real secrets.
POSTGRES_USER=edumall
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_DB=edumall_dev
DATABASE_URL=postgresql://edumall:replace-with-local-only-password@localhost:5432/edumall_dev?schema=public
REDIS_URL=redis://localhost:6379
CORS_ALLOWED_ORIGINS=http://localhost:3000
